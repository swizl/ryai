// ryai 配置：GGUF 张量布局骨架
// 真实文件读取（mmap + 取字节/取整数32）在 D1 接入，骨架先做布局与对齐计算。

// 量化类型
1 = 量化浮点32;
2 = 量化浮点16;
3 = 量化Q8_0;
4 = 量化Q4_0;

// 每个量化块的元素数与字节数（GGUF 的块大小均为 32 元素）
32 = 块元素;
128 = 字节浮点32;
64 = 字节浮点16;
34 = 字节Q8_0;
18 = 字节Q4_0;

// 张量起始偏移按 32 字节对齐（GGUF 默认为 32）
32 = 张量对齐;

// 张量槽 6：0 偏移 1 字节数 2 量化类型 3 块数 4 元素数 5 有效
6 = 张量槽宽;
32 = 最大张量;

// 模型上下文槽：0 张量数 1 总字节 2 数据池句柄 3 对齐值
8 = 模型槽数;
0 = 模张量数;
1 = 模总字节;
2 = 模数据池;
3 = 模对齐;
