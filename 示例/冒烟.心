// ryai 骨架冒烟：张量登记 / 32 字节对齐 / 量化字节数 / 布局游标
导入 "../源/配置.心";
导入 "../源/模型.心";

函数 (条件: 整数, 名称: 字符串)断言 {
    如果 (条件 ?= 1) {
        ("[OK]   ")打印;
        (名称)打印;
    } 否则 {
        ("[FAIL] ")打印;
        (名称)打印;
        (1)退出进程;
    }
}

函数 主程序 {
    ("=== ryai 骨架冒烟 ===")打印;

    (0, 32)向上对齐 = 零对齐;
    (1, 32)向上对齐 = 一对齐;
    (68, 32)向上对齐 = 六八对齐;
    (零对齐 ?= 0, "0 向上对齐 32 = 0")断言;
    (一对齐 ?= 32, "1 向上对齐 32 = 32")断言;
    (六八对齐 ?= 96, "68 向上对齐 32 = 96")断言;

    (量化Q8_0, 2)量化字节 = q8字节;
    (量化Q4_0, 1)量化字节 = q4字节;
    (量化浮点32, 1)量化字节 = f32字节;
    (量化浮点16, 1)量化字节 = f16字节;
    (q8字节 ?= 68, "Q8_0 两块 = 68 字节")断言;
    (q4字节 ?= 18, "Q4_0 一块 = 18 字节")断言;
    (f32字节 ?= 128, "F32 一块 = 128 字节")断言;
    (f16字节 ?= 64, "F16 一块 = 64 字节")断言;

    (张量对齐)模型新建 = 模;
    ("模型句柄=")打印;
    (模)打印;
    (模)模型张量数 = 初始数;
    (初始数 ?= 0, "新建模型张量数为 0")断言;

    (模, 量化Q8_0, 2)张量登记 = 零号;
    (模, 量化浮点32, 1)张量登记 = 一号;
    (模, 量化Q4_0, 1)张量登记 = 二号;
    (零号 ?= 0, "第一个张量序号 = 0")断言;
    (一号 ?= 1, "第二个张量序号 = 1")断言;
    (二号 ?= 2, "第三个张量序号 = 2")断言;

    (模)模型张量数 = 张量数;
    (张量数 ?= 3, "模型张量数 = 3")断言;

    (模, 0)张量偏移 = 偏零;
    (模, 1)张量偏移 = 偏一;
    (模, 2)张量偏移 = 偏二;
    ("偏移=")打印;
    (偏零)打印;
    (偏一)打印;
    (偏二)打印;
    (偏零 ?= 0, "张量 0 偏移 = 0")断言;
    (偏一 ?= 96, "张量 1 偏移按 32 字节对齐到 96")断言;
    (偏二 ?= 224, "张量 2 偏移 = 224")断言;

    (模, 0)张量字节 = 字节零;
    (模, 1)张量字节 = 字节一;
    (字节零 ?= 68, "张量 0 字节数 = 68")断言;
    (字节一 ?= 128, "张量 1 字节数 = 128")断言;

    (模, 2)张量元素数 = 元素二;
    (元素二 ?= 32, "张量 2 元素数 = 32")断言;

    (模)模型总字节 = 总字节;
    ("总字节=")打印;
    (总字节)打印;
    (总字节 ?= 242, "模型总字节 = 224 + 18 = 242")断言;

    (模, 3)张量偏移 = 越界偏移;
    (越界偏移 ?= 0, "未登记序号返回 0")断言;

    ("=== ryai 骨架通过 ===")打印;
}
